     1                                  ; プロテクトモードの割り込みと例外。
     2                                  ;
     3                                  ; pm_hello が「境界を越えて生きて戻る」だったのに対し、こちらは
     4                                  ; **割り込みの作法がモードで丸ごと入れ替わる**ことを確かめる。
     5                                  ;
     6                                  ; リアルモード: IVT (0番地の 4バイト×256 の表) を引いて seg:off へ飛ぶ
     7                                  ; 保護モード:   IDT (8バイトのゲート記述子の表) を引き、**ゲートが
     8                                  ;               「どのセグメントの、どこへ、どの作法で」を全部言う**
     9                                  ;
    10                                  ; 確かめる2経路:
    11                                  ;   1. int 0x40           — ソフトウェア割り込みがゲートを通る。iretd で戻る
    12                                  ;   2. ud2 (0F 0B)        — **例外 (#UD, ベクタ6)**。CPUが自分で起こす割り込み。
    13                                  ;                           handler は戻らず目印を書いて HLT (フォールトは
    14                                  ;                           同じ命令へ戻るので、iretd すると永久ループになる)
    15                                  ;
    16                                  ; アセンブル: nasm -f bin -o pm_idt.bin pm_idt.asm
    17                                  
    18                                  org 0x7C00
    19                                  bits 16
    20                                  
    21                                  start:
    22 00000000 FA                          cli
    23 00000001 31C0                        xor  ax, ax
    24 00000003 8ED8                        mov  ds, ax
    25 00000005 0F0116[B800]                lgdt [gdtr]
    26 0000000A 0F011E[BE00]                lidt [idtr]                 ; ★ IDTもここで教える (0F 01 /3)
    27 0000000F 0F20C0                      mov  eax, cr0
    28 00000012 6683C801                    or   eax, 1
    29 00000016 0F22C0                      mov  cr0, eax
    30 00000019 EA[1E00]0800                jmp  0x08:pm_entry
    31                                  
    32                                  bits 32
    33                                  pm_entry:
    34 0000001E 66B81000                    mov  ax, 0x10
    35 00000022 8ED8                        mov  ds, ax
    36 00000024 8ED0                        mov  ss, ax
    37 00000026 BC00700000                  mov  esp, 0x7000
    38                                  
    39                                      ; --- 経路1: ソフトウェア割り込み。ゲートを通って、iretd で戻ってくる ---
    40                                      ; ベクタ7を使うのは**表を8本で済ませて512バイトに収める**ため。
    41                                      ; 0x41本並べると表だけで520バイトになりブートセクタから溢れる
    42 0000002B CD07                        int  7
    43                                      ; (0x504 の目印は handler 側が書く)
    44 0000002D C70508050000FE5AC2-         mov  dword [0x508], 0xBAC2_5AFE ; iretd で帰ってきた証拠
    44 00000036 BA                 
    45                                  
    46                                      ; --- 経路2: 例外。ud2 は「わざと #UD を起こす」ための公式の命令 ---
    47 00000037 0F0B                        ud2
    48                                      ; ここへは戻らない (handlerがHLTする)。戻ったらこの目印が書かれてしまう
    49 00000039 C7050C050000AD0BAD-         mov  dword [0x50C], 0xDEAD_0BAD
    49 00000042 DE                 
    50 00000043 F4                          hlt
    51                                  
    52                                  ; int 7 の受け手。目印を書いて iretd で帰る
    53                                  soft_handler:
    54 00000044 C705040500003412F7-         mov  dword [0x504], 0x50F7_1234
    54 0000004D 50                 
    55 0000004E CF                          iretd
    56                                  
    57                                  ; #UD の受け手。フォールトは同じ命令へ戻るので、帰らずに目印を書いて止まる
    58                                  ud_handler:
    59 0000004F C705000500000B0FAD-         mov  dword [0x500], 0x0BAD_0F0B
    59 00000058 0B                 
    60 00000059 F4                          hlt
    61                                  
    62                                  ; ---- GDT (pm_hello と同じ: null / 32bitコード / 32bitデータ) ----
    63 0000005A 90<rep 6h>              align 8
    64                                  gdt:
    65 00000060 0000000000000000            dq 0
    66 00000068 FFFF0000                    dw 0xFFFF, 0x0000
    67 0000006C 009ACF00                    db 0x00, 0x9A, 0xCF, 0x00
    68 00000070 FFFF0000                    dw 0xFFFF, 0x0000
    69 00000074 0092CF00                    db 0x00, 0x92, 0xCF, 0x00
    70                                  gdt_end:
    71                                  
    72                                  ; ---- IDT ----
    73                                  ;
    74                                  ; ゲート記述子も8バイト。offsetが上下に割れているのはGDTの記述子と
    75                                  ; 同じ理由 (286の形に32bit分を継ぎ足した)。
    76                                  ;   type 0x8E = 割り込みゲート (present, DPL=0, 32bit。IFを落として入る)
    77                                  %macro idt_gate 1
    78                                      dw (%1 - $$ + 0x7C00) & 0xFFFF  ; offset[15:0]
    79                                      dw 0x08                          ; セレクタ (コードセグメント)
    80                                      db 0
    81                                      db 0x8E                          ; P=1 DPL=0 32bit interrupt gate
    82                                      dw ((%1 - $$ + 0x7C00) >> 16)   ; offset[31:16]
    83                                  %endmacro
    84                                  
    85                                  align 8
    86                                  idt:
    87                                      ; ベクタ0..5: 空 (P=0)。踏んだら「not present」でエミュレータが咎める
    88 00000078 0000000000000000-           times 6 dq 0
    88 00000078 <rep 6h>           
    89                                      idt_gate ud_handler             ; ベクタ6 = #UD
    78 000000A8 4F7C                <1>  dw (%1 - $$ + 0x7C00) & 0xFFFF
    79 000000AA 0800                <1>  dw 0x08
    80 000000AC 00                  <1>  db 0
    81 000000AD 8E                  <1>  db 0x8E
    82 000000AE 0000                <1>  dw ((%1 - $$ + 0x7C00) >> 16)
    90                                      idt_gate soft_handler           ; ベクタ7 (ソフト割り込みの実験台)
    78 000000B0 447C                <1>  dw (%1 - $$ + 0x7C00) & 0xFFFF
    79 000000B2 0800                <1>  dw 0x08
    80 000000B4 00                  <1>  db 0
    81 000000B5 8E                  <1>  db 0x8E
    82 000000B6 0000                <1>  dw ((%1 - $$ + 0x7C00) >> 16)
    91                                  idt_end:
    92                                  
    93                                  gdtr:
    94 000000B8 1700                        dw gdt_end - gdt - 1
    95 000000BA [60000000]                  dd gdt
    96                                  
    97                                  idtr:
    98 000000BE 3F00                        dw idt_end - idt - 1
    99 000000C0 [78000000]                  dd idt
   100                                  
   101 000000C4 00<rep 13Ah>            times 510-($-$$) db 0
   102 000001FE 55AA                    dw 0xAA55
